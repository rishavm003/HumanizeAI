{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/src/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/dist/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/reset-credits-task",
      "schedule": "0 0 * * *"
    }
  ]
}
